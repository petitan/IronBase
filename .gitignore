# Rust
target/
**/*.rs.bk
# Cargo.lock for libraries (binaries should commit their own)
/Cargo.lock
!ironbase-tui/Cargo.lock
!mcp-server/Cargo.lock

# Python
venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# Database files
*.db
*.mlite
*.mlite.lock
*.mlite.bak
*.wal
*.idx
*.fzidx
*.mlite.backup
*.mlite.backup_fix

# Debug files
debug_*.py
test_*.db
test_*.mlite

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Zone Identifier (Windows)
*:Zone.Identifier

# Test outputs
examples/data/*.db
examples/data/*.mlite
ironbase-core/*.mlite

# Proptest regressions
**/proptest-regressions/

# Fuzz testing corpus and artifacts
**/fuzz/corpus/
**/fuzz/artifacts/

# TLS test certificates
mcp-server/cert.pem
mcp-server/key.pem
mcp-server/config.toml

# Log files
**/logs/
*.log

# .NET build outputs
**/bin/
**/obj/
*.dll
*.pdb
*.exe
*.ftidx
*.hnsw
*.mlite.compact
